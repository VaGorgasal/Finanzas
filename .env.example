# Público: URL y clave publishable de un proyecto EXCLUSIVO de Brújula.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: nunca usar prefijo NEXT_PUBLIC_ para estos secretos.
SUPABASE_SERVICE_ROLE_KEY=
EODHD_API_KEY=
# Selecciona un ID válido del catálogo de AI Gateway; sin valor no se llama al modelo.
AI_GATEWAY_MODEL=
# Opcional en Vercel (OIDC); requerido fuera de Vercel.
AI_GATEWAY_API_KEY=
# Activar solo después de aplicar infra/schema.sql y probar aislamiento y cuotas.
ENABLE_REMOTE_FEATURES=false
NEWS_LICENSE_CONFIRMED=false
# Solo tras confirmar derechos de visualización, acceso a fundamentales e histórico y presupuesto.
MARKET_RESEARCH_LICENSE_CONFIRMED=false
# Beta restringida opcional: UUID de usuarios separados por coma.
BETA_USER_IDS=
